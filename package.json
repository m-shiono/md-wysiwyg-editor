{
  "name": "vsc-md-editor",
  "displayName": "MD WYSIWYG Editor",
  "description": "WYSIWYG Markdown editor with tables, Mermaid, Marp preview, and image paste",
  "version": "0.3.14",
  "publisher": "mshiono",
  "author": "mshiono",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/m-shiono/md-wysiwyg-editor.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCustomEditor:md-wysiwyg-editor.wysiwyg",
    "onLanguage:markdown",
    "onCommand:md-wysiwyg-editor.openWithWysiwyg",
    "onCommand:md-wysiwyg-editor.reloadExtension",
    "onCommand:md-wysiwyg-editor.showNativeMarkdownPreview",
    "onCommand:md-wysiwyg-editor.showNativeMarkdownPreviewToSide",
    "onCommand:md-wysiwyg-editor.exportDocument",
    "onCommand:md-wysiwyg-editor.exportHtml",
    "onCommand:md-wysiwyg-editor.exportPdf",
    "onCommand:md-wysiwyg-editor.exportDocx",
    "onCommand:md-wysiwyg-editor.exportPptx",
    "onCommand:md-wysiwyg-editor.convertCsvToMarkdownTable",
    "onCommand:md-wysiwyg-editor.convertMarkdownTableToCsv",
    "onCommand:md-wysiwyg-editor.copyTableAsCsv",
    "onCommand:md-wysiwyg-editor.copyAsBacklog",
    "onCommand:md-wysiwyg-editor.pasteBacklogAsMarkdown"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "md-wysiwyg-editor.wysiwyg",
        "displayName": "MD WYSIWYG Editor",
        "selector": [
          {
            "scheme": "file",
            "filenamePattern": "*.md"
          },
          {
            "scheme": "untitled",
            "filenamePattern": "*.md"
          },
          {
            "scheme": "vscode-remote",
            "filenamePattern": "*.md"
          }
        ],
        "priority": "default",
        "diffEditorPriority": "option"
      }
    ],
    "commands": [
      {
        "command": "md-wysiwyg-editor.toggleReadonly",
        "title": "Toggle Readonly Mode",
        "category": "MD WYSIWYG Editor"
      },
      {
        "command": "md-wysiwyg-editor.showMarpPreview",
        "title": "Show Marp Preview",
        "category": "MD WYSIWYG Editor"
      },
      {
        "command": "md-wysiwyg-editor.openWithWysiwyg",
        "title": "Open with WYSIWYG Editor",
        "category": "MD WYSIWYG Editor",
        "icon": "$(open-preview)"
      },
      {
        "command": "md-wysiwyg-editor.reloadExtension",
        "title": "Reload Plugin",
        "category": "MD WYSIWYG Editor",
        "icon": "$(refresh)"
      },
      {
        "command": "md-wysiwyg-editor.showNativeMarkdownPreview",
        "title": "Open VS Code Markdown Preview",
        "category": "MD WYSIWYG Editor"
      },
      {
        "command": "md-wysiwyg-editor.showNativeMarkdownPreviewToSide",
        "title": "Open VS Code Markdown Preview",
        "category": "MD WYSIWYG Editor"
      },
      {
        "command": "md-wysiwyg-editor.exportDocument",
        "title": "Export Document...",
        "category": "MD WYSIWYG Editor",
        "icon": "$(export)"
      },
      {
        "command": "md-wysiwyg-editor.exportHtml",
        "title": "Export to HTML",
        "category": "MD WYSIWYG Editor"
      },
      {
        "command": "md-wysiwyg-editor.exportPdf",
        "title": "Export to PDF",
        "category": "MD WYSIWYG Editor"
      },
      {
        "command": "md-wysiwyg-editor.exportDocx",
        "title": "Export to DOCX (Word)",
        "category": "MD WYSIWYG Editor"
      },
      {
        "command": "md-wysiwyg-editor.exportPptx",
        "title": "Export to PPTX (PowerPoint)",
        "category": "MD WYSIWYG Editor"
      },
      {
        "command": "md-wysiwyg-editor.convertCsvToMarkdownTable",
        "title": "Convert CSV/TSV to Markdown Table",
        "category": "MD WYSIWYG Editor"
      },
      {
        "command": "md-wysiwyg-editor.convertMarkdownTableToCsv",
        "title": "Convert Markdown Table to CSV",
        "category": "MD WYSIWYG Editor"
      },
      {
        "command": "md-wysiwyg-editor.copyTableAsCsv",
        "title": "Copy Table as CSV",
        "category": "MD WYSIWYG Editor"
      },
      {
        "command": "md-wysiwyg-editor.copyAsBacklog",
        "title": "Copy as Backlog Format",
        "category": "MD WYSIWYG Editor"
      },
      {
        "command": "md-wysiwyg-editor.pasteBacklogAsMarkdown",
        "title": "Paste Backlog as Markdown",
        "category": "MD WYSIWYG Editor"
      }
    ],
    "configuration": {
      "title": "MD WYSIWYG Editor",
      "properties": {
        "md-wysiwyg-editor.defaultMode": {
          "type": "string",
          "scope": "resource",
          "enum": [
            "source",
            "visual",
            "preview"
          ],
          "default": "visual",
          "enumDescriptions": [
            "Source (Raw Markdown editor)",
            "Visual (WYSIWYG rich editor)",
            "Preview (Editor Preview)"
          ],
          "description": "Default editor mode when opening a Markdown file."
        },
        "md-wysiwyg-editor.autoRestoreOnBuiltinSwitch": {
          "type": "boolean",
          "default": false,
          "description": "Automatically reopen the WYSIWYG editor when switching from it to the built-in Markdown editor via the IDE title bar."
        },
        "md-wysiwyg-editor.plantuml.jarPath": {
          "type": "string",
          "default": "",
          "description": "Path to the local plantuml.jar file. If empty, the PLANTUML_JAR environment variable or system PATH will be searched."
        },
        "md-wysiwyg-editor.plantuml.command": {
          "type": "string",
          "default": "",
          "description": "Custom command to run PlantUML (e.g. 'plantuml' or 'java'). If empty, default executable search is used."
        },
        "md-wysiwyg-editor.table.pipeAlignment": {
          "type": "string",
          "enum": [
            "aligned",
            "compact"
          ],
          "default": "aligned",
          "description": "Pipe table delimiter alignment style: 'aligned' pads cells with spaces to keep column pipes vertically aligned, 'compact' uses minimal spaces."
        }
      }
    },
    "configurationDefaults": {
      "workbench.diffEditorAssociations": {
        "*.md": "default"
      },
      "workbench.editorAssociations": {
        "{git}:/**/*.md": "default"
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "md-wysiwyg-editor.reloadExtension",
          "when": "resourceExtname == .md",
          "group": "navigation@0",
          "icon": "$(refresh)"
        },
        {
          "command": "md-wysiwyg-editor.toggleReadonly",
          "when": "activeCustomEditorId == md-wysiwyg-editor.wysiwyg",
          "group": "navigation"
        },
        {
          "command": "md-wysiwyg-editor.exportDocument",
          "when": "resourceExtname == .md && activeCustomEditorId == md-wysiwyg-editor.wysiwyg",
          "group": "navigation@1",
          "icon": "$(export)"
        },
        {
          "command": "md-wysiwyg-editor.openWithWysiwyg",
          "when": "resourceExtname == .md && activeCustomEditorId != md-wysiwyg-editor.wysiwyg",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "md-wysiwyg-editor.convertCsvToMarkdownTable",
          "when": "editorHasSelection && (editorLangId == markdown || resourceExtname == .md)",
          "group": "7_modification@1"
        },
        {
          "command": "md-wysiwyg-editor.convertMarkdownTableToCsv",
          "when": "editorLangId == markdown || resourceExtname == .md",
          "group": "7_modification@2"
        },
        {
          "command": "md-wysiwyg-editor.copyTableAsCsv",
          "when": "editorLangId == markdown || resourceExtname == .md",
          "group": "7_modification@3"
        },
        {
          "command": "md-wysiwyg-editor.copyAsBacklog",
          "when": "editorLangId == markdown || resourceExtname == .md",
          "group": "7_modification@4"
        },
        {
          "command": "md-wysiwyg-editor.pasteBacklogAsMarkdown",
          "when": "editorLangId == markdown || resourceExtname == .md",
          "group": "7_modification@5"
        }
      ]
    }
  },
  "scripts": {
    "compile": "node esbuild.config.mjs && tsc",
    "watch": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext ts",
    "format": "prettier --write \"src/**/*.ts\" \"media/**/*.ts\"",
    "test:unit": "npm run compile && node ./out/test/runUnit.js",
    "test:integration": "npm run compile && node ./out/test/runTest.js",
    "test": "npm run test:unit && npm run test:integration",
    "package:vsix": "SOURCEMAP=0 npm run compile && rm -f dist/*.map media/*.map && vsce package",
    "vscode:prepublish": "SOURCEMAP=0 npm run compile && rm -f dist/*.map media/*.map"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "@xmldom/xmldom": "^0.9.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/dompurify": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "glob": "^11.0.0",
    "jsdom": "^24.1.3",
    "mocha": "^12.0.3",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@marp-team/marp-core": "^4.0.0",
    "@mermaid-js/layout-elk": "^0.2.3",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-code-block-lowlight": "3.31.4",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/extension-link": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/extension-table-cell": "3.31.4",
    "@tiptap/extension-table-header": "3.31.4",
    "@tiptap/extension-table-row": "3.31.4",
    "@tiptap/extension-task-item": "3.31.4",
    "@tiptap/extension-task-list": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "dompurify": "^3.4.14",
    "katex": "^0.17.0",
    "lowlight": "^3.1.0",
    "mdast-util-from-markdown": "^2.0.2",
    "mdast-util-gfm-strikethrough": "^2.0.0",
    "mdast-util-gfm-table": "^2.0.0",
    "mdast-util-gfm-task-list-item": "^2.0.0",
    "mdast-util-to-markdown": "^2.1.2",
    "mermaid": "^11.4.0",
    "micromark-extension-gfm-strikethrough": "^2.1.0",
    "micromark-extension-gfm-table": "^2.1.0",
    "micromark-extension-gfm-task-list-item": "^2.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.0",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.0.0",
    "unified": "^11.0.5"
  }
}
